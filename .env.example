# PostgreSQL
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LOCAL_PASSWORD
POSTGRES_DB=ems_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://ems_user:REPLACE_WITH_UNIQUE_LOCAL_PASSWORD@db:5432/ems_db
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
SEED_DEMO_DATA=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

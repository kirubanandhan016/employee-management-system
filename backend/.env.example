# Use a local PostgreSQL database and replace the placeholder credentials.
DATABASE_URL=postgresql+psycopg://ems_user:REPLACE_WITH_UNIQUE_LOCAL_PASSWORD@localhost:5432/ems_db
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
SEED_DEMO_DATA=false
